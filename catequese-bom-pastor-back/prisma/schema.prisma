generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                        BigInt                     @id @default(autoincrement())
  nome                      String                    
  email                     String                     @unique(map: "email")
  senha                     String                    
  telefone                  String?                   
  ativo                     Boolean?                   @default(true)
  dataCadastro              DateTime?                  @default(now()) @map("data_cadastro")
  ultimoAcesso              DateTime?                  @map("ultimo_acesso")
  primeiroAcesso            Boolean                    @default(false) @map("primeiro_acesso")
  catequista                Catequista?
  comunicados               Comunicado[]
  disponibilizacoesConteudo DisponibilizacaoConteudo[]
  decisoesMatricula         MatriculaDecisao[]
  mensagensRecebidas        Mensagem[]                 @relation("MensagemDestinatario")
  mensagensEnviadas         Mensagem[]                 @relation("MensagemRemetente")
  tokensPasswordSetup       PasswordSetupToken[]
  responsavel               Responsavel?
  perfis                    UsuarioPerfil[]

  @@map("usuario")
}

model Perfil {
  id        BigInt          @id @default(autoincrement())
  nome      String          @unique(map: "nome")
  descricao String?        
  usuarios  UsuarioPerfil[]

  @@map("perfil")
}

model UsuarioPerfil {
  usuarioId BigInt  @map("usuario_id")
  perfilId  BigInt  @map("perfil_id")
  perfil    Perfil  @relation(fields: [perfilId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_perfil_perfil")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_perfil_usuario")

  @@id([usuarioId, perfilId])
  @@index([perfilId], map: "idx_usuario_perfil_perfil_id")
  @@map("usuario_perfil")
}

model Responsavel {
  id            BigInt         @id @default(autoincrement())
  usuarioId     BigInt         @unique @map("usuario_id")
  cpf           String        
  parentesco    String?       
  catequizandos Catequizando[]
  matriculas    Matricula[]
  usuario       Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_responsavel_usuario")

  @@map("responsavel")
}

model Catequista {
  id                        BigInt                     @id @default(autoincrement())
  usuarioId                 BigInt                     @unique @map("usuario_id")
  formacao                  String?                   
  dataIngresso              DateTime?                  @map("data_ingresso")
  usuario                   Usuario                    @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_catequista_usuario")
  disponibilizacoesConteudo DisponibilizacaoConteudo[]
  turmas                    TurmaCatequista[]

  @@map("catequista")
}

model Matricula {
  id                             BigInt             @id @default(autoincrement())
  dataSolicitacao                DateTime?          @default(now()) @map("data_solicitacao")
  status                         String            
  observacao                     String?           
  dataAprovacao                  DateTime?          @map("data_aprovacao")
  responsavelId                  BigInt?            @map("responsavel_id")
  responsavelNome                String             @map("responsavel_nome")
  responsavelCpf                 String             @map("responsavel_cpf")
  responsavelParentesco          String             @map("responsavel_parentesco")
  responsavelDataNascimento      DateTime           @map("responsavel_data_nascimento")
  responsavelTelefone            String             @map("responsavel_telefone")
  responsavelWhatsapp            String             @map("responsavel_whatsapp")
  responsavelEmail               String             @map("responsavel_email")
  catequizandoNome               String             @map("catequizando_nome")
  catequizandoDataNascimento     DateTime           @map("catequizando_data_nascimento")
  catequizandoEndereco           String             @map("catequizando_endereco")
  catequizandoTelefoneEmergencia String             @map("catequizando_telefone_emergencia")
  etapaId                        BigInt             @map("etapa_id")
  catequizando                   Catequizando?
  documentos                     Documento[]
  etapa                          EtapaCatequetica   @relation(fields: [etapaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_matricula_etapa")
  responsavel                    Responsavel?       @relation(fields: [responsavelId], references: [id], onUpdate: NoAction, map: "fk_matricula_responsavel")
  decisoes                       MatriculaDecisao[]

  @@index([responsavelId], map: "idx_matricula_responsavel")
  @@index([etapaId], map: "idx_matricula_etapa")
  @@map("matricula")
}

model MatriculaDecisao {
  id          BigInt    @id @default(autoincrement())
  matriculaId BigInt    @map("matricula_id")
  usuarioId   BigInt    @map("usuario_id")
  etapa       String   
  resultado   String   
  parecer     String?  
  decididoEm  DateTime  @default(now()) @map("decidido_em")
  matricula   Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_matricula_decisao_matricula")
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_matricula_decisao_usuario")

  @@index([matriculaId, decididoEm], map: "idx_matricula_decisao_matricula_data")
  @@index([usuarioId], map: "idx_matricula_decisao_usuario")
  @@map("matricula_decisao")
}

model PasswordSetupToken {
  id        BigInt             @id @default(autoincrement())
  usuarioId BigInt             @map("usuario_id")
  tokenHash String             @unique(map: "uk_password_setup_token_hash") @map("token_hash")
  expiraEm  DateTime           @map("expira_em")
  usadoEm   DateTime?          @map("usado_em")
  criadoEm  DateTime           @default(now()) @map("criado_em")
  tipo      TipoPasswordSetup?
  usuario   Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_password_setup_token_usuario")

  @@index([usuarioId, expiraEm], map: "idx_password_setup_token_usuario_expira")
  @@map("password_setup_token")
}

model Catequizando {
  id                 BigInt                  @id @default(autoincrement())
  matriculaId        BigInt?                 @unique @map("matricula_id")
  responsavelId      BigInt                  @map("responsavel_id")
  turmaId            BigInt?                 @map("turma_id")
  nome               String                 
  dataNascimento     DateTime                @map("data_nascimento")
  sexo               String?                
  endereco           String?                
  telefoneEmergencia String?                 @map("telefone_emergencia")
  situacao           String?                
  dataIngresso       DateTime?               @map("data_ingresso")
  matricula          Matricula?              @relation(fields: [matriculaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catequizando_matricula")
  responsavel        Responsavel             @relation(fields: [responsavelId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catequizando_responsavel")
  turma              Turma?                  @relation(fields: [turmaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catequizando_turma")
  reposicoes         CatequizandoReposicao[]
  frequencias        Frequencia[]
  participacoes      ParticipacaoEvento[]
  sacramentos        Sacramento[]

  @@index([responsavelId], map: "idx_catequizando_responsavel")
  @@index([turmaId], map: "idx_catequizando_turma")
  @@map("catequizando")
}

model Turma {
  id            BigInt                @id @default(autoincrement())
  etapaId       BigInt                @map("etapa_id")
  nome          String               
  ano           Int
  horario       String?              
  local         String?              
  ativa         Boolean?              @default(true)
  catequizandos Catequizando[]
  comunicados   Comunicado[]
  encontros     EncontroCatequetico[]
  eventos       Evento[]
  etapa         EtapaCatequetica      @relation(fields: [etapaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_turma_etapa")
  catequistas   TurmaCatequista[]

  @@index([etapaId], map: "idx_turma_etapa")
  @@map("turma")
}

model EtapaCatequetica {
  id         BigInt          @id @default(autoincrement())
  nome       String         
  descricao  String?        
  ordem      Int
  ativa      Boolean?        @default(true)
  conteudos  EtapaConteudo[]
  matriculas Matricula[]
  turmas     Turma[]

  @@map("etapa_catequetica")
}

model Documento {
  id            BigInt    @id @default(autoincrement())
  matriculaId   BigInt    @map("matricula_id")
  nomeArquivo   String    @map("nome_arquivo")
  tipoDocumento String    @map("tipo_documento")
  status        String   
  parecer       String?  
  dataEnvio     DateTime? @default(now()) @map("data_envio")
  matricula     Matricula @relation(fields: [matriculaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_documento_matricula")

  @@index([matriculaId], map: "idx_documento_matricula")
  @@map("documento")
}

model Evento {
  id            BigInt               @id @default(autoincrement())
  turmaId       BigInt?              @map("turma_id")
  titulo        String              
  descricao     String?             
  dataEvento    DateTime             @map("data_evento")
  local         String?             
  obrigatorio   Boolean?             @default(true)
  turma         Turma?               @relation(fields: [turmaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_evento_turma")
  participacoes ParticipacaoEvento[]

  @@index([turmaId], map: "idx_evento_turma")
  @@map("evento")
}

model Comunicado {
  id             BigInt    @id @default(autoincrement())
  usuarioId      BigInt    @map("usuario_id")
  turmaId        BigInt?   @map("turma_id")
  tipoComunicado String    @map("tipo_comunicado")
  titulo         String   
  conteudo       String   
  dataPublicacao DateTime? @default(now()) @map("data_publicacao")
  turma          Turma?    @relation(fields: [turmaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comunicado_turma")
  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_comunicado_usuario")

  @@index([usuarioId], map: "idx_comunicado_usuario")
  @@index([turmaId], map: "idx_comunicado_turma")
  @@map("comunicado")
}

model Frequencia {
  id             BigInt              @id @default(autoincrement())
  catequizandoId BigInt              @map("catequizando_id")
  encontroId     BigInt              @map("encontro_id")
  status         String             
  dataRegistro   DateTime?           @default(now()) @map("data_registro")
  catequizando   Catequizando        @relation(fields: [catequizandoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_freq_catequizando")
  encontro       EncontroCatequetico @relation(fields: [encontroId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_freq_encontro")
  justificativas Justificativa[]

  @@unique([catequizandoId, encontroId], map: "uk_frequencia")
  @@index([encontroId], map: "idx_freq_encontro")
  @@map("frequencia")
}

model Reposicao {
  id            BigInt                  @id @default(autoincrement())
  data          DateTime               
  local         String?                
  observacao    String?                
  catequizandos CatequizandoReposicao[]

  @@map("reposicao")
}

model Justificativa {
  id                 BigInt     @id @default(autoincrement())
  frequenciaId       BigInt     @map("frequencia_id")
  motivo             String    
  arquivoComprovante String?    @map("arquivo_comprovante")
  analise            String?   
  status             String?    @default("PENDENTE")
  dataEnvio          DateTime?  @default(now()) @map("data_envio")
  frequencia         Frequencia @relation(fields: [frequenciaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_justificativa_frequencia")

  @@index([frequenciaId], map: "idx_justificativa_frequencia")
  @@map("justificativa")
}

model Sacramento {
  id              BigInt       @id @default(autoincrement())
  catequizandoId  BigInt       @map("catequizando_id")
  tipo            String      
  dataRecebimento DateTime?    @map("data_recebimento")
  paroquia        String?     
  comprovante     String?     
  catequizando    Catequizando @relation(fields: [catequizandoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sacramento_catequizando")

  @@index([catequizandoId], map: "idx_sacramento_catequizando")
  @@map("sacramento")
}

model MaterialApoio {
  id         BigInt              @id @default(autoincrement())
  conteudoId BigInt              @map("conteudo_id")
  titulo     String             
  categoria  String?            
  arquivo    String?            
  conteudo   ConteudoCatequetico @relation(fields: [conteudoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_material_conteudo")

  @@index([conteudoId], map: "idx_material_conteudo")
  @@map("material_apoio")
}

model ConteudoCatequetico {
  id                BigInt                     @id @default(autoincrement())
  titulo            String                    
  descricao         String?                   
  dataCriacao       DateTime?                  @default(now()) @map("data_criacao")
  disponibilizacoes DisponibilizacaoConteudo[]
  encontros         EncontroCatequetico[]
  etapas            EtapaConteudo[]
  materiais         MaterialApoio[]

  @@map("conteudo_catequetico")
}

model DisponibilizacaoConteudo {
  id                   BigInt              @id @default(autoincrement())
  conteudoId           BigInt              @map("conteudo_id")
  catequistaId         BigInt              @map("catequista_id")
  usuarioLiberadorId   BigInt              @map("usuario_liberador_id")
  dataDisponibilizacao DateTime?           @default(now()) @map("data_disponibilizacao")
  ativo                Boolean?            @default(true)
  observacao           String?            
  catequista           Catequista          @relation(fields: [catequistaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_disp_catequista")
  conteudo             ConteudoCatequetico @relation(fields: [conteudoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_disp_conteudo")
  usuarioLiberador     Usuario             @relation(fields: [usuarioLiberadorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_disp_usuario")

  @@index([conteudoId], map: "idx_disp_conteudo")
  @@index([catequistaId], map: "idx_disp_catequista")
  @@index([usuarioLiberadorId], map: "idx_disp_usuario")
  @@map("disponibilizacao_conteudo")
}

model EncontroCatequetico {
  id          BigInt              @id @default(autoincrement())
  turmaId     BigInt              @map("turma_id")
  conteudoId  BigInt              @map("conteudo_id")
  data        DateTime           
  tema        String?            
  observacoes String?            
  conteudo    ConteudoCatequetico @relation(fields: [conteudoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_encontro_conteudo")
  turma       Turma               @relation(fields: [turmaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_encontro_turma")
  frequencias Frequencia[]

  @@index([turmaId], map: "idx_encontro_turma")
  @@index([conteudoId], map: "idx_encontro_conteudo")
  @@map("encontro_catequetico")
}

model EtapaConteudo {
  etapaId    BigInt              @map("etapa_id")
  conteudoId BigInt              @map("conteudo_id")
  conteudo   ConteudoCatequetico @relation(fields: [conteudoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ec_conteudo")
  etapa      EtapaCatequetica    @relation(fields: [etapaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ec_etapa")

  @@id([etapaId, conteudoId])
  @@index([conteudoId], map: "idx_ec_conteudo")
  @@map("etapa_conteudo")
}

model ParticipacaoEvento {
  eventoId       BigInt       @map("evento_id")
  catequizandoId BigInt       @map("catequizando_id")
  presente       Boolean?     @default(false)
  catequizando   Catequizando @relation(fields: [catequizandoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pe_catequizando")
  evento         Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pe_evento")

  @@id([eventoId, catequizandoId])
  @@index([catequizandoId], map: "idx_pe_catequizando")
  @@map("participacao_evento")
}

model CatequizandoReposicao {
  catequizandoId BigInt       @map("catequizando_id")
  reposicaoId    BigInt       @map("reposicao_id")
  catequizando   Catequizando @relation(fields: [catequizandoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cr_catequizando")
  reposicao      Reposicao    @relation(fields: [reposicaoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cr_reposicao")

  @@id([catequizandoId, reposicaoId])
  @@index([reposicaoId], map: "idx_cr_reposicao")
  @@map("catequizando_reposicao")
}

model TurmaCatequista {
  turmaId      BigInt     @map("turma_id")
  catequistaId BigInt     @map("catequista_id")
  catequista   Catequista @relation(fields: [catequistaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tc_catequista")
  turma        Turma      @relation(fields: [turmaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tc_turma")

  @@id([turmaId, catequistaId])
  @@index([catequistaId], map: "idx_tc_catequista")
  @@map("turma_catequista")
}

model Mensagem {
  id             BigInt    @id @default(autoincrement())
  remetenteId    BigInt    @map("remetente_id")
  destinatarioId BigInt    @map("destinatario_id")
  texto          String   
  lida           Boolean?  @default(false)
  dataEnvio      DateTime? @default(now()) @map("data_envio")
  destinatario   Usuario   @relation("MensagemDestinatario", fields: [destinatarioId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_msg_destinatario")
  remetente      Usuario   @relation("MensagemRemetente", fields: [remetenteId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_msg_remetente")

  @@index([remetenteId], map: "idx_msg_remetente")
  @@index([destinatarioId], map: "idx_msg_destinatario")
  @@map("mensagem")
}

enum TipoPasswordSetup {
  PRIMEIRO_ACESSO
  RESET_SENHA
}


